{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/create-alert{,/**}",
        "function": { "functionId": "createAlert", "region": "us-central1" }
      },
      {
        "source": "/api/subscribe{,/**}",
        "function": { "functionId": "subscribe", "region": "us-central1" }
      },
      {
        "source": "/api/run-alert-check{,/**}",
        "function": { "functionId": "runAlertCheckNow", "region": "us-central1" }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
